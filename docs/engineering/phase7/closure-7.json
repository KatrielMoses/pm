  "boundaries": [
    {
      "id": "DQ-28",
      "kind": "open_question",
      "statement": "No secret store or KMS is approved: production AI and transcription stay disabled; only the labelled fixture transports exist."
    },
    {
      "id": "OD-31",
      "kind": "open_decision",
      "statement": "Retrieval stays lexical; no embeddings, vector store, or semantic provider."
    },
    {
      "id": "OD-41",
      "kind": "open_decision",
      "statement": "Provider data-use terms are unreviewed: no live provider receives workspace data and nothing is live-provider-tested."
    },
    {
      "id": "OD-46",
      "kind": "open_decision",
      "statement": "Workspace-provided keys stay off when deployed; real-model input and cost bounds remain unverified."
    },
    {
      "id": "OD-25",
      "kind": "open_decision",
      "statement": "Briefing notes stay personal to their author (safe default); brand-scoped notes remain undecided."
    },
    {
      "id": "OD-16",
      "kind": "recorded_decision",
      "statement": "A verified project update is one with a verification fact; generated and unverified updates are labelled."
    },
    {
      "id": "OD-36",
      "kind": "open_decision",
      "statement": "Technical AI content retention stays unset (off); no legal retention period is chosen."
    },
    {
      "id": "PRJ-007",
      "kind": "requirement_boundary",
      "statement": "Project AI budgets are not enforced; paid project-scoped runs are refused, never relabelled as workspace runs."
    },
    {
      "id": "10A",
      "kind": "later_subphase",
      "statement": "Commercial entitlements and billing; Phase 7 usage is never billable and the entitlement port denies by default when deployed."
    },
    {
      "id": "DOC-019",
      "kind": "requirement_boundary",
      "statement": "Attachment text, OCR, and file bytes are not AI sources."
    },
    {
      "id": "BRF-010",
      "kind": "foundation",
      "statement": "Agent-run review stays an explicit unavailable statement until Phase 8C supplies real agent runs."
    },
    {
      "id": "9D",
      "kind": "later_subphase",
      "statement": "Release readiness lists missing evidence and never certifies or publishes."
    },
    {
      "id": "REL-FU-7A-01",
      "kind": "follow_up",
      "statement": "The generic effect ledger still treats a pending effect as retryable after a crash; no Phase 7 path relies on it, and it is a prerequisite before Phase 8 reuses unsafe crash recovery."
    },
    {
      "id": "ACCOUNT-DELETION",
      "kind": "later_subphase",
      "statement": "The account-deletion command belongs to a later phase; the AI personal-data eraser is registered and proven through productPersonalDataRegistry."
    },
    {
      "id": "MANUAL",
      "kind": "manual",
      "statement": "Device microphones, real speech quality, live providers, and screen readers are manual checks; deterministic fixtures prove the paths only."
    }
  ],
  "accepted_limits": [
    "fact-only briefings",
