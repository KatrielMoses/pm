  "boundaries": [
    {
      "id": "OD-31",
      "statement": "Semantic (meaning-based) search remains undecided: retrieval is lexical through 5A and says so; no embeddings, vector store, or provider were added."
    },
    {
      "id": "DOC-019",
      "statement": "Attachment text, OCR, and file bytes are not AI sources (4E quarantine and the attachment-search boundary hold)."
    },
    {
      "id": "DQ-28",
      "statement": "No production secret store: production AI stays disabled exactly as in 7A."
    },
    {
      "id": "OD-41",
      "statement": "Provider data-use terms are unreviewed: no real model receives workspace data."
    },
    {
      "id": "OD-46",
      "statement": "Workspace-provided keys stay off when deployed."
    },
    {
      "id": "PRJ-007",
      "statement": "Project AI budgets are not enforced; paid project-scoped runs are refused, never relabelled as workspace runs."
    },
    {
      "id": "REL-FU-7A-01",
      "statement": "The effect-ledger reliability follow-up stays tracked; 7B adds no unsafe-effect recovery path."
    },
    {
      "id": "7C",
      "statement": "Drafting, analysis, change proposals, briefings, planning, and agents are later subphases; 7B is read-only."
    }
  ]
}
