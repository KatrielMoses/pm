  "boundaries": [
    {
      "id": "8D",
      "statement": "Per-instance approval, review, acceptance, and deliverable promotion; every non-R0 tool waits as approval_required; no accept control exists."
    },
    {
      "id": "10A",
      "statement": "Technical limits only; no plan, price, or entitlement."
    },
    {
      "id": "PRODUCTION-CONNECTORS",
      "statement": "Live connectors are blocked until an approved secret store and credentials exist (DQ-28); dispatch is exercised only against the synthetic local fixture, refused when deployed."
    },
