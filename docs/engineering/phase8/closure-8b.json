      "statement": "Per-instance approval, review, and acceptance; R3/R4 stay human-approved and execution unavailable."
    },
    {
      "id": "10A",
      "statement": "Technical limits only; no plan, price, or entitlement."
    },
    {
      "id": "10B",
      "statement": "Five starter templates only; no catalog or distribution."
    },
    {
      "id": "PRODUCTION-CONNECTORS",
