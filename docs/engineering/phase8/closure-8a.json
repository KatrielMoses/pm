      "id": "10A",
      "statement": "Usage is measured against technical limits; plan entitlements are labelled unavailable."
    },
    {
      "id": "10B",
      "statement": "Five starter templates only; no catalog or distribution."
    },
    {
      "id": "PRODUCTION-AI",
      "statement": "No production AI provider is configured; verification uses the deterministic fixture; no live or paid call."
    },
    {
      "id": "NO-EXACTLY-ONCE",
      "statement": "Automation webhooks are unsafe: no automatic duplicate after ambiguity and authorized reconciliation, never exactly-once delivery."
