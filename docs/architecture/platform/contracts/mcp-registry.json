{
  "schema_version": 1,
  "protocol_version": "2025-11-25",
  "registry_version": "1",
  "tools": [
    {
      "name": "pm.tasks.list",
      "version": "1",
      "description": "List tasks visible to the caller. Pagination uses cursor and limit.",
      "requiredScopes": ["records:read", "records:write", "views:read"],
      "mutating": false,
      "destructive": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "cursor": { "type": "string", "maxLength": 4096 },
          "brand": { "type": "string", "maxLength": 64, "description": "Optional brand public id filter" }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "pm.tasks.get",
      "version": "1",
      "description": "Fetch one task by public id when readable.",
      "requiredScopes": ["records:read", "records:write", "views:read"],
      "mutating": false,
      "destructive": false,
      "inputSchema": {
        "type": "object",
        "required": ["task_id"],
        "properties": { "task_id": { "type": "string", "maxLength": 64 } },
        "additionalProperties": false
      }
    },
    {
      "name": "pm.tasks.create",
      "version": "1",
      "description": "Create a task in a brand the caller may write.",
      "requiredScopes": ["records:write"],
      "mutating": true,
      "destructive": false,
      "inputSchema": {
        "type": "object",
        "required": ["title", "brand"],
        "properties": {
          "title": { "type": "string", "maxLength": 500 },
          "brand": { "type": "string", "maxLength": 64 },
          "project": { "type": "string", "maxLength": 64 }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "pm.tasks.complete",
      "version": "1",
      "description": "Mark a task complete. Requires confirm=true.",
      "requiredScopes": ["records:write"],
      "mutating": true,
      "destructive": true,
      "inputSchema": {
        "type": "object",
        "required": ["task_id", "confirm"],
        "properties": {
          "task_id": { "type": "string", "maxLength": 64 },
          "confirm": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  ],
  "resources": [
    {
      "uri": "pm://workspace/mcp/help",
      "name": "MCP setup guide",
      "description": "How to connect an external assistant using OAuth and MCP tools.",
      "mimeType": "text/markdown",
      "requiredScopes": ["records:read", "records:write", "views:read"]
    },
    {
      "uri": "pm://workspace/mcp/capabilities",
      "name": "MCP capabilities",
      "description": "Server protocol version and registered tool/resource versions.",
      "mimeType": "application/json",
      "requiredScopes": ["records:read", "records:write", "views:read"]
    }
  ]
}
