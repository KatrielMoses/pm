{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pm:schema:audit-event",
  "title": "Audit event",
  "x-visibility": "internal",
  "x-max-class": "C3",
  "type": "object",
  "required": [
    "id",
    "occurred_at",
    "workspace_id",
    "action",
    "actor",
    "target",
    "correlation_id",
    "retention_class"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "urn:pm:schema:common#/$defs/internal_uuid"
    },
    "occurred_at": {
      "$ref": "urn:pm:schema:common#/$defs/timestamp"
    },
    "workspace_id": {
      "$ref": "urn:pm:schema:common#/$defs/internal_uuid"
    },
    "brand_id": {
      "$ref": "urn:pm:schema:common#/$defs/internal_uuid"
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z_]+\\.[a-z_]+$"
    },
    "actor": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "urn:pm:schema:common#/$defs/actor_type"
        },
        "id": {
          "$ref": "urn:pm:schema:common#/$defs/internal_uuid"
        },
        "on_behalf_of": {
          "$ref": "urn:pm:schema:common#/$defs/internal_uuid"
        },
        "delegation_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string"
              },
              "id": {
                "$ref": "urn:pm:schema:common#/$defs/internal_uuid"
              }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "$ref": "urn:pm:schema:common#/$defs/internal_uuid"
        },
        "type": {
          "type": "string"
        },
        "public_id": {
          "$ref": "urn:pm:schema:common#/$defs/public_id"
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "class"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "class": {
            "type": "string",
            "enum": [
              "plain",
              "content",
              "personal",
              "secret",
              "credential_ref"
            ]
          },
          "old": {},
          "new": {},
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "version_ref": {
            "type": "string"
          },
          "redacted": {
            "type": "boolean"
          },
          "changed": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "type": "object",
              "required": [
                "class"
              ],
              "additionalProperties": true,
              "properties": {
                "class": {
                  "const": "secret"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "old"
                    ]
                  },
                  {
                    "required": [
                      "new"
                    ]
                  },
                  {
                    "required": [
                      "hash"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "operation_id": {
      "$ref": "urn:pm:schema:common#/$defs/internal_uuid"
    },
    "attempt_id": {
      "$ref": "urn:pm:schema:common#/$defs/internal_uuid"
    },
    "correlation_id": {
      "$ref": "urn:pm:schema:common#/$defs/trace_id"
    },
    "causation_id": {
      "$ref": "urn:pm:schema:common#/$defs/internal_uuid"
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "workflow_revision_id": {
      "$ref": "urn:pm:schema:common#/$defs/internal_uuid"
    },
    "retention_class": {
      "const": "R-AUDIT"
    }
  }
}