{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pm:schema:attempt",
  "title": "Attempt",
  "x-visibility": "public",
  "x-max-class": "C2",
  "type": "object",
  "required": [
    "id",
    "number",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "urn:pm:schema:common#/$defs/public_id"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "$ref": "urn:pm:schema:common#/$defs/exec_state"
    },
    "terminal_reason": {
      "$ref": "urn:pm:schema:common#/$defs/terminal_reason"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "retryable"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "started_at": {
      "$ref": "urn:pm:schema:common#/$defs/timestamp"
    },
    "ended_at": {
      "$ref": "urn:pm:schema:common#/$defs/timestamp"
    },
    "worker_lost": {
      "type": "boolean"
    }
  }
}