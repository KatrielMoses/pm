{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pm:schema:collection-page",
  "title": "Collection page",
  "x-visibility": "public",
  "x-max-class": "C2",
  "type": "object",
  "required": [
    "data",
    "page",
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "$ref": "urn:pm:schema:common#/$defs/public_id"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "limit",
        "has_more"
      ],
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,2048}$"
        },
        "prev_cursor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,2048}$"
        },
        "total": {
          "type": "object",
          "required": [
            "value",
            "estimated",
            "capped"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "estimated": {
              "type": "boolean"
            },
            "capped": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "meta": {
      "$ref": "urn:pm:schema:meta"
    },
    "view": {
      "description": "Query metadata for saved-view query collections (Phase 3A, PL-28): visible columns, group summaries computed with the identical authorized predicate as the rows, and labels for the filter values the caller can read (unreadable and unknown values are both absent).",
      "type": "object",
      "required": [
        "columns",
        "refs"
      ],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "field",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string",
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        },
        "groups": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label",
              "count"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              },
              "label": {
                "type": "string",
                "maxLength": 1000
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "groups_truncated": {
          "type": "boolean"
        },
        "refs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}