{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pm:schema:rich-text",
  "title": "Rich text (version 1)",
  "x-visibility": "public",
  "x-max-class": "C2",
  "description": "Versioned rich-text document (PQ-06, DQ-25; first increment PL-23). Version 1 is the plain-text subset: paragraphs of unmarked text, one paragraph per line. Phase 4C adds node and mark types under the same envelope and version field; version 1 documents stay valid. Length limits apply to the extracted text (paragraphs joined by a line break, in code points), never to serialized JSON. A document with no non-whitespace text is refused; null is the only empty value.",
  "type": "object",
  "required": [
    "type",
    "version",
    "content"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "doc"
    },
    "version": {
      "const": 1
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:pm:schema:rich-text#/$defs/paragraph"
      }
    }
  },
  "$defs": {
    "paragraph": {
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "urn:pm:schema:rich-text#/$defs/text"
          }
        }
      }
    },
    "text": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u0008\\u000a-\\u001f\\u007f]+$",
          "x-class": "C2"
        }
      }
    }
  }
}
