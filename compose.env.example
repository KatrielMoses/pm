# Local container environment only. Copy to compose.env (gitignored) and replace every value.
POSTGRES_PASSWORD=replace-me-admin
PM_ROLE_PASSWORD_MIGRATOR=replace-me-migrator
PM_ROLE_PASSWORD_RESTORE_OPERATOR=replace-me-restore
PM_ROLE_PASSWORD_APP_RW=replace-me-app
PM_ROLE_PASSWORD_APP_WORKER=replace-me-worker
PM_ROLE_PASSWORD_DISPATCHER=replace-me-dispatcher
# base64url of 32 random bytes each
PM_AUTH_SIGNING_KEY=replace-me
PM_DEV_VAULT_KEY=replace-me
