# Local development only. Copy to .env (gitignored): `pnpm db:local` can generate it for you.
# CI and deployed environments never read .env; they receive injected variables (docs/engineering/environments.md).
APP_ENV=local

# One login role per identity (0C §12.3). Passwords are local-only placeholders; replace them.
DATABASE_APP_URL=postgres://app_rw:CHANGE_ME_app@127.0.0.1:54329/pm_local
DATABASE_WORKER_URL=postgres://app_worker:CHANGE_ME_worker@127.0.0.1:54329/pm_local
DATABASE_DISPATCHER_URL=postgres://dispatcher:CHANGE_ME_dispatcher@127.0.0.1:54329/pm_local
# Used only by `pnpm migrate`; never by the web/API or worker processes.
DATABASE_MIGRATOR_URL=postgres://migrator:CHANGE_ME_migrator@127.0.0.1:54329/pm_local

HTTP_HOST=127.0.0.1
HTTP_PORT=3000
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Identity (1B). Development adapters only: production modes refuse them.
PUBLIC_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000
# base64url of 32 random bytes each, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SIGNING_KEY=CHANGE_ME
SECRET_VAULT=dev-database
DEV_VAULT_KEY=CHANGE_ME
MAIL_TRANSPORT=capture
# Captured mail (with one-time links) lands here as JSON files; never share them.
MAIL_CAPTURE_DIR=.local/mailbox
COOKIE_SECURE=false
OAUTH_PROVIDERS=local

# MCP-compatible access foundation (6E). Disable invocation while leaving its capability visible.
MCP_ENABLED=1
MCP_READ_RATE_PER_MINUTE=120
MCP_WRITE_RATE_PER_MINUTE=60
MCP_TOOL_CALL_TIMEOUT_MS=30000
MCP_TOOL_RESULT_MAX_BYTES=65536
IMPORT_ROLLBACK_PERIOD=604800000
OAUTH_CLIENTS_MAX=100

# Lifecycle (1F). Retention periods are product-owner decisions: leave RETENTION_PERIODS unset so
# no scheduled purge runs. The local purge ledger is a development adapter outside the database.
# RETENTION_PERIODS={"R-LIVE": <milliseconds>}
PURGE_LEDGER=local
PURGE_LEDGER_DIR=.local/purge-ledger
# Local/test only: /_harness/lifecycle renders the reusable lifecycle components.
COMPONENT_HARNESS=true
