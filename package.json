{
  "name": "pm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.8.1"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "dev": "node scripts/dev.mjs",
    "db:local": "node --conditions=@pm/source scripts/local-db.ts",
    "build": "pnpm run contracts:generate:check && tsc -b && pnpm --filter @pm/web build",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && pnpm --filter @pm/web typecheck",
    "lint": "eslint . --max-warnings=0 && node scripts/check-sql-safety.mjs && node scripts/check-workspace-graph.mjs && node scripts/check-dockerfile.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit --project web",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:integration",
    "validate:phase0": "python3 docs/architecture/tools/phase0.py",
    "validate:phase1": "python3 docs/engineering/tools/phase1.py",
    "validate:phase2": "python3 docs/engineering/tools/phase2.py",
    "validate:phase3": "python3 docs/engineering/tools/phase3.py",
    "validate:phase3d": "python3 docs/engineering/tools/phase3d.py",
    "validate:phase3b": "python3 docs/engineering/tools/phase3b.py",
    "validate:phase3c": "python3 docs/engineering/tools/phase3c.py",
    "validate:phase3e": "python3 docs/engineering/tools/phase3e.py",
    "validate:phase4a": "python3 docs/engineering/tools/phase4a.py",
    "validate:phase4b": "python3 docs/engineering/tools/phase4b.py",
    "validate:phase4c": "python3 docs/engineering/tools/phase4c.py",
    "validate:phase4e": "python3 docs/engineering/tools/phase4e.py",
    "contracts:generate": "node packages/contracts/scripts/generate.mjs",
    "contracts:generate:check": "node packages/contracts/scripts/generate.mjs --check",
    "migrate": "node packages/db/dist/cli/migrate.js",
    "deps:licenses": "node scripts/dependency-report.mjs",
    "scan:deps": "node scripts/scan-deps.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "ajv": "8.20.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "@pm/test-support": "workspace:*",
    "@axe-core/playwright": "4.13.0"
  }
}
